DATABASE_URL=postgresql+asyncpg://lifelens:lifelens_secret@localhost:5432/lifelens_db
REDIS_URL=redis://localhost:6379/0
# Use a random 32+ character value. Required when ENVIRONMENT is not development/testing.
SECRET_KEY=
FINANCIAL_WEBHOOK_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ENVIRONMENT=development
FRONTEND_URL=http://localhost:8081

# AI provider (optional; the assistant falls back to deterministic responses without a key)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_PROVIDER=auto
LLM_MODEL=gemini-1.5-pro
