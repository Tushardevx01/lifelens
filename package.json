{
  "name": "lifelens-root",
  "version": "1.0.0",
  "private": true,
  "description": "LifeLens AI — Root Monorepo Orchestrator",
  "scripts": {
    "start": "npm start --prefix frontend",
    "android": "npm run android --prefix frontend",
    "ios": "npm run ios --prefix frontend",
    "web": "npm run web --prefix frontend",
    "lint": "npm run lint --prefix frontend",
    "lint:fix": "npm run lint:fix --prefix frontend",
    "format": "npm run format --prefix frontend",
    "format:check": "npm run format:check --prefix frontend",
    "typecheck": "npm run typecheck --prefix frontend",
    "test": "npm test --prefix frontend",
    "test:frontend": "npm test --prefix frontend",
    "test:backend": "cd backend && .venv/bin/pytest tests/ -v",
    "build": "npm run build --prefix frontend",
    "build:web": "npm run build:web --prefix frontend"
  }
}
