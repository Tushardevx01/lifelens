# Expo / React Native frontend
EXPO_PUBLIC_API_URL=http://localhost:8000

# Backend (copy to backend/.env)
# Required by docker-compose; use random 32+ character values.
SECRET_KEY=
FINANCIAL_WEBHOOK_SECRET=
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+asyncpg://lifelens:lifelens_secret@localhost:5432/lifelens_db
REDIS_URL=redis://localhost:6379/0
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ENVIRONMENT=development
FRONTEND_URL=http://localhost:8081

# AI provider (optional; the assistant falls back to deterministic responses without a key)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_PROVIDER=auto
LLM_MODEL=gemini-1.5-pro

